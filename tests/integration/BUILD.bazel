load(":run.bzl", "integration_check")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "suite",
    srcs = [
        "LICENSE",
        "suite.json",
    ] + glob(
        [
            "tests/**",
            "profiles/**",
        ],
        allow_empty = True,
    ),
)

integration_check(
    name = "check",
    script = "check-integration",
)
