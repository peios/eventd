#!/bin/sh
# Acquire a portable snapshot, or consume it in an already isolated native environment.
set -eu
operation=${1:?usage: offline-build acquire SNAPSHOT | build/test SNAPSHOT WORK}
snapshot=${2:?snapshot directory required}
case "$snapshot" in /*) ;; *)
    echo "Snapshot directory must be absolute" >&2
    exit 1
    ;;
esac
case "$operation" in
acquire)
    [ ! -e "$snapshot" ] || {
        echo "Snapshot already exists: $snapshot" >&2
        exit 1
    }
    mkdir -p "$snapshot"
    export XDG_CACHE_HOME="$snapshot/tool-cache"
    ./bazel --batch --output_base="$snapshot/acquisition" vendor \
        --vendor_dir="$snapshot/repositories" //...
    python3 tools/bazel-vendor.py freeze "$snapshot/repositories"
    mkdir "$snapshot/tools"
    cp "$XDG_CACHE_HOME/peios/bazel/$(cat .bazelversion)/bazel" "$snapshot/tools/bazel"
    cp MODULE.bazel.lock "$snapshot/MODULE.bazel.lock"
    ;;
build | test)
    work=${3:?private work directory required}
    case "$work" in /*) ;; *)
        echo "Work directory must be absolute" >&2
        exit 1
        ;;
    esac
    python3 - "$snapshot/MODULE.bazel.lock" <<'PY_LOCK'
import sys
from pathlib import Path

if Path("MODULE.bazel.lock").read_bytes() != Path(sys.argv[1]).read_bytes():
    raise SystemExit("Snapshot module lock differs from the source tree; acquire a new snapshot.")
PY_LOCK
    mkdir -p "$work"
    python3 tools/bazel-vendor.py view "$snapshot/repositories" "$work/repositories"
    PEIOS_BAZEL_BINARY="$snapshot/tools/bazel" \
        ./bazel --batch --output_base="$work/output" --install_base="$work/install" \
        "$operation" --config=peios --vendor_dir="$work/repositories" \
        --repository_cache="$work/cache" --repository_disable_download \
        --lockfile_mode=error //:packages //...
    ;;
*)
    echo "Unknown operation: $operation" >&2
    exit 1
    ;;
esac
