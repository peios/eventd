#!/bin/bash
# Download the pinned Bazel binary once; keep it outside the source tree.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
    echo "Eventd builds require x86_64 Linux." >&2
    exit 1
fi
version=$(cat "$here/.bazelversion")
expected=$(cat "$here/build/bazel.sha256")
cache="${XDG_CACHE_HOME:-$HOME/.cache}/peios/bazel/$version"
binary="${PEIOS_BAZEL_BINARY:-$cache/bazel}"
valid() {
    [[ -f $1 ]] && [[ $(sha256sum "$1" | cut -d' ' -f1) == "$expected" ]]
}
if ! valid "$binary"; then
    if [[ -n ${PEIOS_BAZEL_BINARY:-} ]]; then
        echo "The supplied Bazel binary does not match build/bazel.sha256." >&2
        exit 1
    fi
    mkdir -p "$cache"
    temp=$(mktemp "$cache/download.XXXXXX")
    trap 'rm -f -- "$temp"' EXIT
    curl --fail --location --proto '=https' --tlsv1.2 \
        "https://releases.bazel.build/$version/release/bazel-$version-linux-x86_64" -o "$temp"
    valid "$temp" || {
        echo "Bazel download checksum mismatch." >&2
        exit 1
    }
    chmod 755 "$temp"
    mv -f -- "$temp" "$binary"
    trap - EXIT
fi
exec "$binary" "$@"
