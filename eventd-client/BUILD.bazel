load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "benches/**",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "eventd-client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "eventd_client",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["--check-cfg=cfg(loom,test)"],
    version = VERSION,
    deps = [] + all_crate_deps(normal = True),
)

rust_test(
    name = "tests",
    size = "medium",
    crate = ":eventd-client",
    deps = all_crate_deps(normal_dev = True),
)
